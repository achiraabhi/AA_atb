# ATB Configuration
# Copy this file to .env and edit for your setup

# Hardware mode: mock (simulation) or real (physical relay board)
HARDWARE_MODE=mock

# Serial port for the relay MCU (only used when HARDWARE_MODE=real)
# Linux/Pi: /dev/ttyUSB0 or /dev/ttyACM0
# Windows:  COM3
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUD=115200

# Server port (default 8000)
PORT=8000
