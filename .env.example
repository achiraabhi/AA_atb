# ATB Configuration
# Copy this file to .env and edit for your setup

# Serial port for the relay MCU (physical relay board is required)
# Linux/Pi: /dev/ttyUSB0 or /dev/ttyACM0
# Windows:  COM3
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUD=115200

# Voltage meter serial ports (one reading per second, streamed to UI as V1/V2)
# V1 = energizing voltage, V2 = measurement voltage
V1_PORT=/dev/ttyACM1
V1_BAUD=115200
V2_PORT=/dev/ttyACM2
V2_BAUD=115200

# Meter driver per channel: serial | ut61 | auto
#   serial = Arduino/MCU meter streaming over the V*_PORT above
#   ut61   = UNI-T UT61B+ multimeter over USB-HID (auto-detected; V*_PORT ignored)
#   auto   = use the UT61B+ if its HID bridge is plugged in, else serial
# The UT61B+ is NOT a serial port — it needs the hidapi package + udev rule
# (see setup_pi.sh / udev/99-unit-dmm.rules). Default V2 to the UT61B+ as the
# precision measurement meter:
V1_DRIVER=ut61
V2_DRIVER=ut61
# Two identical UT61B+ meters: pin serials (from ⚙ Ports), or leave blank=auto.
V1_UT61_SERIAL=
V2_UT61_SERIAL=

# Server port (default 8000)
PORT=8000
