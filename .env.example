# ATB Configuration
# Copy this file to .env and edit for your setup

# Serial port for the relay MCU (physical relay board is required)
# Linux/Pi: /dev/ttyUSB0 or /dev/ttyACM0
# Windows:  COM3
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUD=115200

# Voltage meter serial ports (one reading per second, streamed to UI as V1/V2)
# V1 = energizing voltage, V2 = measurement voltage
V1_PORT=/dev/ttyACM1
V1_BAUD=115200
V2_PORT=/dev/ttyACM2
V2_BAUD=115200

# Server port (default 8000)
PORT=8000
